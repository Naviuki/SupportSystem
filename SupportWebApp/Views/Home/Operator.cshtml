<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Панель операторов техподдержки</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }

        .operator-header {
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(20px);
        }

        .ticket-card {
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(20px);
            border-radius: 15px;
            transition: all 0.3s ease;
            border: 1px solid rgba(255,255,255,0.3);
        }

            .ticket-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 20px 40px rgba(0,0,0,0.15);
            }

        .status-new {
            background: linear-gradient(45deg, #f59e0b, #d97706);
            color: white;
        }

        .status-deleted {
            background: linear-gradient(45deg, #6b7280, #4b5563);
            color: white;
        }
    </style>
</head>
<body>
    <div class="container-fluid py-5">
        <!-- Header -->
        <div class="operator-header shadow-lg rounded-4 p-4 mb-5 mx-auto" style="max-width: 1200px;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold mb-1">
                        <i class="fas fa-headset text-primary me-3"></i>
                        Панель операторов техподдержки
                    </h1>
                    <p class="lead text-muted mb-0">Управление заявками в реальном времени</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-lg" onclick="loadTickets()">
                        <i class="fas fa-sync-alt me-2"></i>Обновить
                    </button>
                    <a href="/" class="btn btn-outline-primary btn-lg">
                        <i class="fas fa-home me-2"></i>Создать заявку
                    </a>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-3">
                    <div class="card bg-primary text-white text-center p-3">
                        <div class="h3 mb-0" id="totalTickets">0</div>
                        <small>Всего заявок</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-dark text-center p-3">
                        <div class="h3 mb-0" id="newTickets">0</div>
                        <small>Новых</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Список заявок -->
        <div class="container" style="max-width: 1200px;">
            <div id="ticketsContainer" class="row g-4">
                <div class="col-12">
                    <div class="alert alert-info text-center">
                        <i class="fas fa-spinner fa-spin me-2"></i>
                        Загрузка заявок...
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const API_BASE = 'http://localhost:5000/api';

        async function loadTickets() {
            try {
                const response = await fetch(`${API_BASE}/tickets`);
                const tickets = await response.json();

                const container = document.getElementById('ticketsContainer');

                // Статистика
                document.getElementById('totalTickets').textContent = tickets.length;
                document.getElementById('newTickets').textContent = tickets.filter(t => t.status === 'New').length;

                if (tickets.length === 0) {
                    container.innerHTML = `
                        <div class="col-12">
                            <div class="alert alert-success">
                                <i class="fas fa-check-circle me-2"></i>
                                ✅ Новых заявок нет
                            </div>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = tickets.map(ticket => `
                    <div class="col-xl-4 col-lg-6 col-md-6">
                        <div class="ticket-card h-100 shadow-lg">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h5 class="card-title mb-0 fw-bold">${ticket.title}</h5>
                                    <span class="badge status-new fs-6 px-3 py-2 rounded-pill fw-semibold">
                                        ${ticket.status}
                                    </span>
                                </div>

                                <p class="card-text text-muted mb-3">${ticket.description}</p>

                                <div class="row text-small mb-3">
                                    <div class="col-6">
                                        <i class="fas fa-user me-1 text-muted"></i>
                                        ${ticket.userEmail}
                                    </div>
                                    <div class="col-6 text-end">
                                        <i class="fas fa-clock me-1 text-muted"></i>
                                        ${new Date(ticket.createdAt).toLocaleString('ru-RU')}
                                    </div>
                                </div>

                                <div class="d-grid gap-2">
                                    <button class="btn btn-danger" onclick="deleteTicket(${ticket.id})">
                                        <i class="fas fa-trash me-2"></i>
                                        Удалить заявку #${ticket.id}
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `).join('');

            } catch (error) {
                document.getElementById('ticketsContainer').innerHTML = `
                    <div class="col-12">
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            ❌ Ошибка загрузки заявок: ${error.message}
                        </div>
                    </div>
                `;
            }
        }

        // ✅ УДАЛЕНИЕ ЗАЯВКИ
        async function deleteTicket(id) {
            if (!confirm(`🗑️ Вы уверены, что хотите удалить заявку #${id}?`)) {
                return;
            }

            try {
                const response = await fetch(`${API_BASE}/tickets/${id}`, {
                    method: 'DELETE'
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    // Успешное удаление с анимацией
                    showToast(`✅ ${result.message}`, 'success');
                    loadTickets(); // Обновляем список
                } else {
                    showToast(`❌ ${result.message}`, 'danger');
                }
            } catch (error) {
                showToast(`❌ Ошибка сети: ${error.message}`, 'danger');
            }
        }

        // Уведомления
        function showToast(message, type) {
            const toast = document.createElement('div');
            toast.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
            toast.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.remove();
            }, 5000);
        }

        // Автообновление каждые 5 секунд
        loadTickets();
        setInterval(loadTickets, 5000);
    </script>
</body>
</html>
