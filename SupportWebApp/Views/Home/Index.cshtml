@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Техподдержка</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container py-5">
        <h1 class="mb-4">Создать заявку в техподдержку</h1>
        <form id="ticketForm">
            <div class="mb-3">
                <label>Заголовок</label>
                <input type="text" class="form-control" id="title" required />
            </div>
            <div class="mb-3">
                <label>Описание</label>
                <textarea class="form-control" id="description" rows="3" required></textarea>
            </div>
            <div class="mb-3">
                <label>Email для уведомления</label>
                <input type="email" class="form-control" id="userEmail" required />
            </div>
            <button type="submit" class="btn btn-primary">Отправить</button>
        </form>
        <div id="msg" class="mt-3"></div>
    </div>

    <script>
        document.getElementById('ticketForm').addEventListener('submit', async e => {
            e.preventDefault();
            const data = {
                title: document.getElementById('title').value,
                description: document.getElementById('description').value,
                category: "Общее",
                priority: "Низкий",
                userEmail: document.getElementById('userEmail').value,
                userName: "Пользователь"
            };

            const response = await fetch('http://localhost:5000/api/tickets', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const msgDiv = document.getElementById('msg');
            if (response.ok) {
                msgDiv.innerHTML = '<div class="alert alert-success">Заявка успешно создана и уведомление отправлено!</div>';
            } else {
                msgDiv.innerHTML = '<div class="alert alert-danger">Ошибка отправки заявки.</div>';
            }
        });
    </script>
</body>
</html>
