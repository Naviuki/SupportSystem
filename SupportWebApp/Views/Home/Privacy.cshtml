@{
    ViewData["Title"] = "Privacy Policy";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Privacy Policy - Техподдержка</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-5 text-center">
                        <i class="fas fa-shield-alt fa-3x text-primary mb-4"></i>
                        <h1 class="display-5 fw-bold mb-3">Политика конфиденциальности</h1>
                        <p class="lead text-muted mb-5">
                            Система техподдержки для учебных целей
                        </p>

                        <div class="row g-4 text-start">
                            <div class="col-md-6">
                                <h5><i class="fas fa-lock me-2 text-success"></i>Защищённые данные</h5>
                                <ul class="list-unstyled">
                                    <li class="mb-2">• Email пользователей (анонимизирован)</li>
                                    <li class="mb-2">• Названия заявок</li>
                                    <li class="mb-2">• Дата создания</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h5><i class="fas fa-info-circle me-2 text-info"></i>Учебный проект</h5>
                                <ul class="list-unstyled">
                                    <li class="mb-2">• Данные хранятся только в памяти</li>
                                    <li class="mb-2">• Никакой передачи третьим лицам</li>
                                    <li class="mb-2">• Автоочистка при перезапуске</li>
                                </ul>
                            </div>
                        </div>

                        <hr class="my-5">

                        <div class="d-grid gap-3 col-lg-6 mx-auto">
                            <a href="/" class="btn btn-primary btn-lg">
                                <i class="fas fa-home me-2"></i>
                                На главную
                            </a>
                            <a href="/Home/Operator" class="btn btn-outline-primary btn-lg">
                                <i class="fas fa-headset me-2"></i>
                                Панель операторов
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</body>
</html>
